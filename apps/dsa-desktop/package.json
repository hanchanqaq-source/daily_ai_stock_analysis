{
  "name": "pp02-ai-daily-stock-analysis-desktop",
  "version": "3.29.5",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "test": "node ../../scripts/verify-release-version.js candidate && node --test tests/*.test.js",
    "test:windows-credentials": "electron tests/windows-secure-credential-harness.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "archiver": "5.3.2",
    "electron": "^31.4.0",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "com.hanchanqaq.pp02.aidailystockanalysis",
    "productName": "PP02 AI Daily Stock Analysis",
    "directories": {
      "output": "dist"
    },
    "afterPack": "scripts/afterPackMacos.js",
    "afterSign": "scripts/afterSignRuntimeIntegrity.js",
    "files": [
      "main.js",
      "preload.js",
      "portable-update/**/*",
      "runtime-integrity/**/*",
      "renderer/**/*",
      "secure-credentials/**/*"
    ],
    "extraResources": [
      {
        "from": "../../.env.example",
        "to": ".env.example"
      },
      {
        "from": "../../dist/backend/stock_analysis",
        "to": "backend/stock_analysis"
      },
      {
        "from": "portable-update/portable-update-helper.ps1",
        "to": "portable-update-helper.ps1"
      },
      {
        "from": "windows/close-owned-processes.ps1",
        "to": "close-owned-processes.ps1"
      },
      {
        "from": "windows/owned-processes.json",
        "to": "owned-processes.json"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "pp02-ai-daily-stock-analysis-windows-installer-v${version}.${ext}",
      "publish": [
        {
          "provider": "github",
          "owner": "hanchanqaq-source",
          "repo": "daily_ai_stock_analysis"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "include": "installer.nsh"
    },
    "mac": {
      "identity": null,
      "hardenedRuntime": false,
      "target": "dmg"
    }
  }
}
